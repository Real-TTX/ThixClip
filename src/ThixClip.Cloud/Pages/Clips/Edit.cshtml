@page "/Clips/Edit"
@model ThixClip.Cloud.Pages.Clips.EditModel
@{
    var clip = Model.Clip;
    var title = Model.IsNew ? "Neuer Eintrag" : clip!.Kind == ClipKind.Image ? "Bild" : clip.Kind == ClipKind.Link ? "Link" : "Text";
    ViewData["Title"] = title;
    ViewData["PageSub"] = Model.IsNew ? "Ein Text oder ein Bild, das sofort auf allen Geräten in der Zwischenablage-Liste steht." : $"Kopiert {Dates.Stamp(clip!.CopiedDate)}{(clip.Source is null ? "" : " auf " + clip.Source)}";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Zwischenablage", null), ("Verlauf", "/Clips"), (title, null) };
    // a new entry is a small form; a clip shows its picture and its facts in the full width (the buttons stay in one row)
    ViewData["Width"] = Model.IsNew ? "narrow" : null;
}

@if (Model.IsNew)
{
    <form class="mat-form" method="post" enctype="multipart/form-data" novalidate>
        <partial name="_FormSummary" model="ViewData.ModelState" />
        <div class="mat-card">
            <div class="mat-card__body mat-form">
                <tc-field name="Kind" kind="radios" label="Art" value="@Model.Kind" options="EditModel.Kinds" />
                <tc-field name="Text" kind="textarea" label="Text" rows="8" value="@Model.Text" show-if="Kind" show-value="Text" required
                          msg-required="Bitte einen Text eingeben." hint="Ein Text, der nur aus einer Adresse (https://…) besteht, wird ein Link." />
                <tc-field name="Image" kind="file" label="Bild" accept="image/png,image/jpeg,image/gif,image/webp,image/bmp" max-size="25MB" show-if="Kind" show-value="Image" required
                          msg-required="Bitte ein Bild auswählen." hint="PNG, JPEG, GIF, WebP oder BMP bis 25 MB. Ein Bild kann auch mit Strg+V eingefügt werden." />
            </div>
        </div>
        <tc-buttons save="Anlegen" save-icon="plus" back="/Clips" />
    </form>
}
else
{
    <form class="mat-form" method="post" novalidate>
        <partial name="_FormSummary" model="ViewData.ModelState" />

        @if (clip!.Kind == ClipKind.Image)
        {
            <div class="mat-card tc-preview">
                @if (clip.HasImage)
                {
                    <a class="tc-preview__image" href="/live/clips/@clip.Id/image" target="_blank" rel="noopener">
                        <img src="/live/clips/@clip.Id/image" alt="Das kopierte Bild" width="@clip.ImageWidth" height="@clip.ImageHeight" />
                    </a>
                }
                else
                {
                    <div class="mat-empty">
                        <span class="mat-empty__icon">@Ui.Icon("upload")</span>
                        <div class="mat-empty__title">Das Bild wird noch übertragen</div>
                        <p>Das Gerät, auf dem es kopiert wurde, lädt es gerade hoch.</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="mat-card">
                <div class="mat-card__body mat-form">
                    <tc-field name="Text" kind="textarea" label="@(clip.Kind == ClipKind.Link ? "Link" : "Text")" rows="10" value="@Model.Text" required mono="@(clip.Kind == ClipKind.Link)"
                              msg-required="Bitte einen Text eingeben." hint="Eine Änderung erreicht alle Geräte." />
                    @if (clip.Kind == ClipKind.Link && ClipContent.IsLink(clip.Text ?? ""))
                    {
                        <p class="tc-open-link"><a href="@clip.Text!.Trim()" target="_blank" rel="noopener noreferrer">@Ui.Icon("external")<span>Link öffnen</span></a></p>
                    }
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(clip.OcrText))
        {
            <div class="mat-card">
                <div class="mat-card__head">
                    <h2 class="mat-card__title">@Ui.Icon("sparkles")Erkannter Text (OCR)</h2>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" data-copy="#ocr-text" aria-label="Erkannten Text kopieren" data-tip="Kopieren">@Ui.Icon("copy")</button>
                </div>
                <div class="mat-card__body">
                    <pre class="tc-ocr" id="ocr-text">@clip.OcrText</pre>
                </div>
            </div>
        }

        <div class="mat-card">
            <div class="mat-card__body mat-form">
                <tc-field name="IsFavorite" kind="switch" label="Favorit (wird nie automatisch gelöscht)" value="@Model.IsFavorite.ToString()" />
                <tc-field name="IsPinned" kind="switch" label="Angeheftet (steht in ThixClip oben)" value="@Model.IsPinned.ToString()" />
            </div>
        </div>

        <div class="mat-card">
            <div class="mat-card__body">
                <dl class="tc-facts">
                    <dt>@Ui.Icon(ClipContent.KindIcon(clip.Kind))Typ</dt>
                    <dd>@(clip.Kind == ClipKind.Image ? $"Bild (PNG{(clip.ImageWidth is null ? "" : $", {clip.ImageWidth} × {clip.ImageHeight}")})" : ClipContent.KindName(clip.Kind))</dd>
                    @if (clip.Kind == ClipKind.Image)
                    {
                        <dt>@Ui.Icon("sparkles")OCR</dt>
                        <dd>@(string.IsNullOrWhiteSpace(clip.OcrText) ? "Kein Text erkannt" : "Text erkannt")</dd>
                        <dt>@Ui.Icon("hard-drive")Größe</dt>
                        <dd>@Ui.Bytes(clip.ImageBytes)</dd>
                    }
                    else
                    {
                        <dt>@Ui.Icon("type")Länge</dt>
                        <dd>@Ui.Number(clip.Text?.Length ?? 0) Zeichen</dd>
                    }
                    <dt>@Ui.Icon("calendar")Erstellt</dt>
                    <dd>@Dates.Stamp(clip.CreatedDate)</dd>
                    <dt>@Ui.Icon("clock")Zuletzt kopiert</dt>
                    <dd>@Dates.Stamp(clip.CopiedDate)</dd>
                    <dt>@Ui.Icon("monitor")Quelle</dt>
                    <dd>@(clip.Source ?? "–")</dd>
                    <dt>@Ui.Icon("archive")Speicherdauer</dt>
                    <dd>@AccountService.RetentionName(clip.RetentionDays)@(clip.ExpiresDate is { } expires ? $" (bis {Dates.Stamp(expires)})" : clip.IsFavorite || clip.IsPinned ? " (bleibt, weil markiert)" : "")</dd>
                </dl>
            </div>
        </div>

        <tc-buttons save="Speichern" back="/Clips" delete-handler="Delete" delete-confirm="Diesen Eintrag löschen? Er verschwindet auch auf allen Geräten.">
            @if (clip.Kind == ClipKind.Image)
            {
                @if (clip.HasImage)
                {
                    <button type="button" class="mat-btn mat-btn--secondary tc-btn-collapse" data-copy-image="/live/clips/@clip.Id/image" aria-label="In Zwischenablage kopieren" data-tip="In Zwischenablage kopieren">@Ui.Icon("copy")<span>Kopieren</span></button>
                    <a class="mat-btn mat-btn--secondary tc-btn-collapse" href="/live/clips/@clip.Id/image?download=true" aria-label="Herunterladen" data-tip="Herunterladen">@Ui.Icon("download")<span>Herunterladen</span></a>
                }
            }
            else
            {
                <button type="button" class="mat-btn mat-btn--secondary tc-btn-collapse" data-copy="#Text" aria-label="In Zwischenablage kopieren" data-tip="In Zwischenablage kopieren">@Ui.Icon("copy")<span>Kopieren</span></button>
            }
        </tc-buttons>
    </form>
}
