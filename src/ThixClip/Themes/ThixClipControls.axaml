<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="ThixClip.ThixClipControls">
  <!--
    The control themes of what only ThixClip has: the history list and its rows, a short list of choices (the duration of
    a pause, the range of "Verlauf löschen") and the paused state of the pause button. Everything else is MatDesktop's
    (MatDesktop/Themes/Controls.axaml). No colour of its own (DESK-02): every value is a resource of MatDesktop's theme,
    so light, dark and the accent come from the tokens. Loaded after MatDesktop's theme (App.Initialize).
  -->

  <!-- The history list: no frame of its own, the rows are cards (HistoryPage). -->
  <ControlTheme x:Key="ThixClip.ClipList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </ControlTheme>

  <!-- A row of the history: only its content (the card is drawn by the page, which knows the states). -->
  <ControlTheme x:Key="ThixClip.ClipRow" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Mat.Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>

  <!--
    A choice in a short list, like a ticked choice of MatUi (mat-choice): the chosen one is a tint of the accent behind the
    whole row with the accent as its line (COLOR-08), the keyboard focus the ring of the accent.
  -->
  <ControlTheme x:Key="ThixClip.ChoiceRow" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Mat.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="{DynamicResource Mat.ControlHeight}" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource Mat.Radius}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="Ring" Margin="-3" BorderThickness="3" CornerRadius="9" BorderBrush="{DynamicResource Mat.FocusRing}" IsVisible="False" />
          <Border Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Frame">
      <Setter Property="Background" Value="{DynamicResource Mat.Surface3}" />
    </Style>
    <Style Selector="^:selected /template/ Border#Frame">
      <Setter Property="Background" Value="{DynamicResource Mat.AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Mat.Accent}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Ring">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- The pause button of the header while recording is paused: the colours of a warning, so nobody forgets it. -->
  <ControlTheme x:Key="ThixClip.PausedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource Mat.WarningText}" />
    <Setter Property="Background" Value="{DynamicResource Mat.WarningBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Mat.Warning}" />
    <Style Selector="^:pointerover /template/ Border#Frame">
      <Setter Property="Background" Value="{DynamicResource Mat.WarningBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Mat.WarningText}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Frame">
      <Setter Property="Background" Value="{DynamicResource Mat.WarningBg}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
