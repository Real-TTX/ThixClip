<mat:MatWindow xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mat="using:MatDesktop"
               xmlns:controls="using:ThixClip.Controls"
               x:Class="ThixClip.MainWindow"
               Title="ThixClip" Width="1180" Height="760" MinWidth="760" MinHeight="460"
               WindowStartupLocation="Manual">
  <!--
    The one window of ThixClip (mockup), in MatDesktop's chrome: the title bar (DESK-03: logo and word mark, the search,
    the pause button and the shortcut in the middle, the caption buttons on Windows, the traffic lights on macOS), the menu
    (DESK-04: the sections, Settings below a line, at its foot the retention, the cloud state, the version = About and the
    fold to a rail) and the page (history, settings, about). It is built once and shown/hidden by the shortcut.
  -->
  <Grid RowDefinitions="Auto,*">
    <mat:MatTitleBar x:Name="TitleBar" AppName="ThixClip" CloseKey="Esc">
      <mat:MatTitleBar.WordMark>
        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Mat.FontSizeXl}" FontWeight="SemiBold">
          <Run Text="Thix" /><Run Text="Clip" Foreground="{DynamicResource Mat.AccentText}" />
        </TextBlock>
      </mat:MatTitleBar.WordMark>
      <mat:MatTitleBar.Center>
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBox x:Name="SearchBox" Theme="{StaticResource MatSearchBox}" MaxWidth="620" HorizontalAlignment="Stretch"
                   Watermark="Zwischenablage durchsuchen" AutomationProperties.Name="Zwischenablage durchsuchen" />

          <!-- Recording: always in sight. Paused: "Fortsetzen" in the colours of a warning with the end of the pause (RefreshPause). -->
          <Button Grid.Column="1" x:Name="PauseButton" Click="OnPauseClick" Margin="12,0,10,0" VerticalAlignment="Center">
            <controls:IconLabel x:Name="PauseLabel" Icon="pause" Text="Pausieren" />
          </Button>

          <Button Grid.Column="2" x:Name="HotkeyBadge" Theme="{StaticResource MatButton.Link}" Click="OnHotkeyBadgeClick" VerticalAlignment="Center"
                  ToolTip.Tip="Tastenkürzel ändern" AutomationProperties.Name="Tastenkürzel">
            <controls:KeyCaps x:Name="HotkeyCaps" Padding="8,3" />
          </Button>
        </Grid>
      </mat:MatTitleBar.Center>
    </mat:MatTitleBar>

    <Grid Grid.Row="1" x:Name="BodyGrid" ColumnDefinitions="Auto,*">
      <!-- The menu; its foot gets the retention and the cloud state above the version (MainWindow.AddToMenuFoot) -->
      <mat:MatNav x:Name="Sidebar" AppName="ThixClip" />
      <ContentControl Grid.Column="1" x:Name="PageHost" />
    </Grid>
  </Grid>
</mat:MatWindow>
