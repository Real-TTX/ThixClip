{
  "id": "/",
  "name": "ThixClip.Cloud",
  "short_name": "ThixClip",
  "description": "Der Zwischenablage-Verlauf aller deiner Geräte: synchron, durchsuchbar (auch Text aus Bildern), im Browser und als App.",
  "lang": "de",
  "start_url": "/Clips",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f5f4f1",
  "theme_color": "#f5f4f1",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/img/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/img/logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Neuer Eintrag", "short_name": "Neu", "url": "/Clips/Edit", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Favoriten", "short_name": "Favoriten", "url": "/Clips?flag=favorite", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Bilder", "short_name": "Bilder", "url": "/Clips?kind=image", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] }
  ]
}
