@page "/Account/Setup"
@model ThixClip.Cloud.Pages.Account.SetupModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Einrichten";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>ThixClip.Cloud einrichten</h1>
        <p class="mat-muted">Willkommen! Lege das erste Konto an. Es verwaltet die Cloud und ist zugleich dein Konto für die ThixClip-App.</p>
    </div>

    <form class="mat-form" method="post" novalidate id="setup-form">
        <partial name="_FormSummary" model="ViewData.ModelState" />
        <tc-field name="UserName" label="Benutzername" required autocomplete="username" value="@Model.UserName" autofocus maxlength="64"
                  hint="Zum Anmelden im Browser und in der App: a–z, Ziffern und . _ - @@" msg-required="Bitte einen Benutzernamen eingeben." />
        <tc-field name="DisplayName" label="Anzeigename" optional autocomplete="name" value="@Model.DisplayName" maxlength="120" />
        <tc-field name="Password" kind="password" label="Passwort" required autocomplete="new-password" minlength="@Passwords.MinLength" hint="Mindestens @Passwords.MinLength Zeichen." msg-required="Bitte ein Passwort wählen." />
        <tc-field name="Repeat" kind="password" label="Passwort wiederholen" required autocomplete="new-password" msg-required="Bitte das Passwort wiederholen." />
        <div class="mat-btn-row mat-btn-row--plain">
            <button type="submit" class="mat-btn mat-btn--primary mat-btn--block">@Ui.Icon("check")<span>Einrichten</span></button>
        </div>
    </form>
</div>
