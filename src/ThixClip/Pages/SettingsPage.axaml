<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mat="using:MatDesktop"
             xmlns:controls="using:ThixClip.Controls"
             x:Class="ThixClip.Pages.SettingsPage">
  <!-- Settings in tabs: Allgemein | Aufzeichnung | Cloud | Updates | Erweitert. A switch applies at once (like macOS). -->
  <Border Background="{DynamicResource Mat.Surface}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,22,28,28" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="Einstellungen" Theme="{StaticResource MatText.PageTitle}" />
        <TextBlock x:Name="PolicyNote" Theme="{StaticResource MatText.Muted}" Margin="0,4,0,0" IsVisible="False"
                   Text="Von deiner Organisation festgelegt: was eine Richtlinie bestimmt, ist hier ausgeschaltet." />
        <controls:InfoBar x:Name="PageMessage" Margin="0,14,0,0" />

        <TabControl x:Name="Tabs" Margin="0,12,0,0">
          <!-- ===== General ===== -->
          <TabItem x:Name="GeneralTabItem" Header="Allgemein">
            <StackPanel>
              <mat:MatSettingRow Title="Tastenkürzel" x:Name="HotkeyRow"
                                   Description="Öffnet ThixClip aus jeder App. Es hat Vorrang vor gleichen Kürzeln anderer Programme.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:HotkeyRecorder x:Name="HotkeyRecorder" />
                  <Button x:Name="HotkeyResetButton" Click="OnHotkeyResetClick" ToolTip.Tip="Standard wiederherstellen">
                    <controls:IconLabel Icon="refresh" Text="Standard" />
                  </Button>
                </StackPanel>
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="Hotkey" Margin="0" />
              <mat:MatSettingRow Title="Bei der Anmeldung starten" Description="ThixClip startet unsichtbar im Infobereich / in der Menüleiste.">
                <ToggleSwitch x:Name="AutostartSwitch" OnContent="" OffContent="" AutomationProperties.Name="Bei der Anmeldung starten" />
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Nach Auswahl direkt einfügen"
                                   Description="Enter oder Doppelklick fügt den Eintrag in die App ein, aus der du ThixClip geöffnet hast. Aus: nur kopieren.">
                <ToggleSwitch x:Name="PasteSwitch" OnContent="" OffContent="" AutomationProperties.Name="Nach Auswahl direkt einfügen" />
              </mat:MatSettingRow>
              <controls:InfoBar x:Name="AccessibilityInfo" />
              <Button x:Name="AccessibilityButton" IsVisible="False" Click="OnAccessibilityClick" Margin="0,0,0,8">
                <controls:IconLabel Icon="lock" Text="Zugriff erlauben …" />
              </Button>
              <mat:MatSettingRow Title="Nach dem Kopieren schließen" Description="Strg/⌘ + C oder „Kopieren“ legt den Eintrag in die Zwischenablage und schließt ThixClip.">
                <ToggleSwitch x:Name="CloseAfterCopySwitch" OnContent="" OffContent="" AutomationProperties.Name="Nach dem Kopieren schließen" />
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Ausblenden, wenn eine andere App aktiv wird" Description="Wie ein Auswahlfenster: ein Klick daneben schließt ThixClip.">
                <ToggleSwitch x:Name="HideSwitch" OnContent="" OffContent="" AutomationProperties.Name="Ausblenden, wenn eine andere App aktiv wird" />
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Erscheinungsbild">
                <ComboBox x:Name="ThemeChoice" MinWidth="170" AutomationProperties.Name="Erscheinungsbild">
                  <ComboBoxItem Content="Wie das System" />
                  <ComboBoxItem Content="Hell" />
                  <ComboBoxItem Content="Dunkel" />
                </ComboBox>
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Speicherdauer" Description="Ältere Einträge werden gelöscht. Favoriten und angeheftete Einträge bleiben." BorderThickness="0">
                <ComboBox x:Name="RetentionChoice" MinWidth="170" AutomationProperties.Name="Speicherdauer" />
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="RetentionDays" Margin="0" />
            </StackPanel>
          </TabItem>

          <!-- ===== Recording / privacy ===== -->
          <TabItem x:Name="RecordingTabItem" Header="Aufzeichnung">
            <StackPanel>
              <mat:MatSettingRow x:Name="PauseRow" Title="Aufzeichnung pausieren">
                <Button x:Name="PauseSettingButton" Click="OnPauseClick">
                  <controls:IconLabel x:Name="PauseSettingLabel" Icon="pause" Text="Pausieren …" />
                </Button>
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Bilder aufzeichnen" Description="Screenshots und kopierte Bilder kommen in den Verlauf.">
                <ToggleSwitch x:Name="ImagesSwitch" OnContent="" OffContent="" AutomationProperties.Name="Bilder aufzeichnen" />
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Text in Bildern erkennen (OCR)" x:Name="OcrRow">
                <ToggleSwitch x:Name="OcrSwitch" OnContent="" OffContent="" AutomationProperties.Name="Text in Bildern erkennen" />
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Vertrauliches nicht aufzeichnen" BorderThickness="0"
                                   Description="Was Passwort-Manager als vertraulich kennzeichnen (z. B. KeePass, 1Password, Bitwarden), landet nie im Verlauf.">
                <ToggleSwitch x:Name="ConfidentialSwitch" OnContent="" OffContent="" AutomationProperties.Name="Vertrauliches nicht aufzeichnen" />
              </mat:MatSettingRow>
            </StackPanel>
          </TabItem>

          <!-- ===== Cloud ===== -->
          <TabItem x:Name="CloudTabItem" Header="Cloud">
            <StackPanel>
              <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,0,0,16"
                         Text="Mit MatCloud ist dein Verlauf auf allen PCs und Macs gleich – neue Einträge, Favoriten und Löschungen werden sofort abgeglichen. Im Browser kommst du auch von unterwegs dran." />
              <controls:InfoBar x:Name="CloudMessage" />

              <!-- Not connected: sign in, in the browser (every account, also MatIdentity) or with user name and password -->
              <StackPanel x:Name="CloudLogin" MaxWidth="520" HorizontalAlignment="Left">
                <mat:MatFormField Label="Adresse der Cloud" controls:FormErrors.Field="ServerUrl" Hint="Die Adresse deiner MatCloud, z. B. https://cloud.example.com">
                  <TextBox x:Name="ServerUrlBox" Watermark="https://" />
                </mat:MatFormField>
                <mat:MatFormField Label="Name dieses Geräts" controls:FormErrors.Field="DeviceName" Hint="So erscheint dieser Computer in der MatCloud unter „Geräte“.">
                  <TextBox x:Name="DeviceNameBox" />
                </mat:MatFormField>

                <!-- The first way: in the browser -->
                <StackPanel x:Name="BrowserSignIn" Margin="0,6,0,0">
                  <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,0,0,12"
                             Text="Die Anmeldung öffnet sich im Browser: Melde dich dort an – mit deinem Konto der MatCloud oder über MatIdentity – und bestätige den Code, den ThixClip dir zeigt." />
                  <controls:ActionBar>
                    <Button x:Name="BrowserConnectButton" Theme="{StaticResource MatButton.Primary}" Click="OnBrowserConnectClick" IsDefault="True">
                      <controls:IconLabel Icon="globe" Text="Im Browser anmelden" />
                    </Button>
                    <Button x:Name="ShowPasswordSignInButton" Click="OnShowPasswordSignInClick">
                      <controls:IconLabel Icon="key" Text="Mit Benutzername und Passwort" />
                    </Button>
                  </controls:ActionBar>
                </StackPanel>

                <!-- Waiting for the browser: the code to compare -->
                <Border x:Name="BrowserCode" Theme="{StaticResource MatCard}" IsVisible="False" Margin="0,6,0,0">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Dein Code" Theme="{StaticResource MatText.Muted}" />
                    <SelectableTextBlock x:Name="BrowserCodeText" FontFamily="{DynamicResource Mat.Mono}" FontSize="{DynamicResource Mat.FontSize3xl}"
                                         FontWeight="SemiBold" LetterSpacing="3" Foreground="{DynamicResource Mat.AccentText}" AutomationProperties.Name="Code" />
                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="Bestätige den Code im Browser." />
                    <TextBlock x:Name="BrowserCodeHint" Theme="{StaticResource MatText.Muted}"
                               Text="Melde dich auf der Seite der MatCloud an und prüfe, dass dort derselbe Code steht. ThixClip verbindet sich, sobald du bestätigt hast." />
                    <controls:ActionBar Margin="0,4,0,0">
                      <Button x:Name="OpenLinkButton" Click="OnOpenLinkClick">
                        <controls:IconLabel Icon="external" Text="Seite erneut öffnen" />
                      </Button>
                      <Button x:Name="CancelLinkButton" Click="OnCancelLinkClick">
                        <controls:IconLabel Icon="x" Text="Abbrechen" />
                      </Button>
                    </controls:ActionBar>
                  </StackPanel>
                </Border>

                <!-- The second way: user name and password of a local account -->
                <StackPanel x:Name="PasswordSignIn" IsVisible="False" Margin="0,6,0,0">
                  <mat:MatFormField Label="Benutzername" controls:FormErrors.Field="UserName">
                    <TextBox x:Name="UserNameBox" />
                  </mat:MatFormField>
                  <mat:MatFormField Label="Passwort" controls:FormErrors.Field="Password" Hint="Wird nur für die Anmeldung gebraucht und nicht gespeichert.">
                    <TextBox x:Name="PasswordBox" PasswordChar="●" />
                  </mat:MatFormField>
                  <controls:ActionBar Margin="0,6,0,0">
                    <Button x:Name="ConnectButton" Theme="{StaticResource MatButton.Primary}" Click="OnConnectClick">
                      <controls:IconLabel Icon="login" Text="Anmelden" />
                    </Button>
                    <Button x:Name="ShowBrowserSignInButton" Click="OnShowBrowserSignInClick">
                      <controls:IconLabel Icon="globe" Text="Im Browser anmelden" />
                    </Button>
                  </controls:ActionBar>
                </StackPanel>
              </StackPanel>

              <!-- Connected: state and actions -->
              <StackPanel x:Name="CloudConnected" IsVisible="False" Spacing="16">
                <Border Theme="{StaticResource MatCard}" MaxWidth="560" HorizontalAlignment="Left">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Text="Cloud" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <SelectableTextBlock Grid.Column="1" x:Name="CloudServerText" Margin="0,4" />
                    <TextBlock Grid.Row="1" Text="Konto" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CloudAccountText" Margin="0,4" />
                    <TextBlock Grid.Row="2" Text="Dieses Gerät" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CloudDeviceText" Margin="0,4" />
                    <TextBlock Grid.Row="3" Text="Status" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CloudStateText" Margin="0,4" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Text="Zuletzt" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CloudLastSyncText" Margin="0,4" />
                  </Grid>
                </Border>
                <controls:ActionBar>
                  <Button Theme="{StaticResource MatButton.Primary}" Click="OnSyncNowClick">
                    <controls:IconLabel Icon="refresh" Text="Jetzt synchronisieren" />
                  </Button>
                  <Button Click="OnOpenCloudClick">
                    <controls:IconLabel Icon="external" Text="Im Browser öffnen" />
                  </Button>
                  <Button x:Name="DisconnectButton" Theme="{StaticResource MatButton.Danger}" controls:ActionBar.Separated="True" Click="OnDisconnectClick">
                    <controls:IconLabel Icon="logout" Text="Abmelden" />
                  </Button>
                </controls:ActionBar>
              </StackPanel>
            </StackPanel>
          </TabItem>

          <!-- ===== Updates ===== -->
          <TabItem x:Name="UpdatesTabItem" Header="Updates">
            <StackPanel>
              <Border Theme="{StaticResource MatCard}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,14">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                  <TextBlock Text="Installiert" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                  <TextBlock Grid.Column="1" x:Name="InstalledVersionText" Margin="0,4" />
                  <TextBlock Grid.Row="1" Text="Kanal" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ChannelText" Margin="0,4" />
                  <TextBlock Grid.Row="2" Text="Zuletzt geprüft" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LastCheckText" Margin="0,4" />
                </Grid>
              </Border>
              <controls:InfoBar x:Name="UpdateMessage" />
              <ProgressBar x:Name="UpdateProgress" Theme="{StaticResource MatProgress}" IsVisible="False" Maximum="1" Margin="0,0,0,12" MaxWidth="560" HorizontalAlignment="Stretch" />
              <controls:ActionBar Margin="0,0,0,10">
                <Button x:Name="CheckUpdateButton" Click="OnCheckUpdateClick">
                  <controls:IconLabel Icon="refresh" Text="Nach Updates suchen" />
                </Button>
                <Button x:Name="InstallUpdateButton" Theme="{StaticResource MatButton.Primary}" Click="OnInstallUpdateClick" IsVisible="False">
                  <controls:IconLabel Icon="download" Text="Update installieren" />
                </Button>
                <Button Click="OnReleasePageClick">
                  <controls:IconLabel Icon="external" Text="Versionen auf GitHub" />
                </Button>
              </controls:ActionBar>
              <mat:MatSettingRow Title="Automatisch nach Updates suchen" Description="Beim Start und alle 6 Stunden, im eigenen Kanal (Release oder Nightly).">
                <ToggleSwitch x:Name="CheckUpdatesSwitch" OnContent="" OffContent="" AutomationProperties.Name="Automatisch nach Updates suchen" />
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Updates automatisch installieren" BorderThickness="0"
                                   Description="Full-Auto-Update: neue Versionen werden ohne Rückfrage installiert, ThixClip startet danach neu im Hintergrund.">
                <ToggleSwitch x:Name="AutoInstallSwitch" OnContent="" OffContent="" AutomationProperties.Name="Updates automatisch installieren" />
              </mat:MatSettingRow>
            </StackPanel>
          </TabItem>

          <!-- ===== Advanced ===== -->
          <TabItem x:Name="AdvancedTabItem" Header="Erweitert">
            <StackPanel>
              <mat:MatSettingRow Title="Datenordner" x:Name="DataFolderRow">
                <Button Click="OnOpenDataFolderClick">
                  <controls:IconLabel Icon="external" Text="Öffnen" />
                </Button>
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Protokolle" x:Name="LogFolderRow" BorderThickness="0">
                <Button Click="OnOpenLogFolderClick">
                  <controls:IconLabel Icon="external" Text="Öffnen" />
                </Button>
              </mat:MatSettingRow>
              <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,16,0,0"
                         Text="Administratoren können ThixClip per Richtlinie einschränken (LockConfiguration, DisableCloud, DisableUpdates) – unter Windows in HKLM\SOFTWARE\Policies\ThixClip, unter macOS per Konfigurationsprofil info.schmoldt.thixclip." />
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
