<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ThixClip.App"
             Name="ThixClip"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <!-- Fluent provides the templates of inputs, combo boxes, switches and scroll bars; Themes/*.axaml give them our look. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#2F6FED" RegionColor="#FFFFFF" ErrorText="#DC2626" />
        <ColorPaletteResources x:Key="Dark" Accent="#3D7BF5" RegionColor="#202024" ErrorText="#F87171" />
      </FluentTheme.Palettes>
    </FluentTheme>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ThixClip/Themes/Icons.axaml" />
        <ResourceInclude Source="avares://ThixClip/Themes/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
