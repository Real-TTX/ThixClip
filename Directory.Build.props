<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Company>Matthias Schmoldt</Company>
    <Product>ThixClip</Product>
    <Authors>Matthias Schmoldt</Authors>
    <Copyright>© Matthias Schmoldt</Copyright>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    The desktop projects (ThixClip.Core, ThixClip, ThixClip.Tests) use the Windows target framework when they are built on
    Windows: it brings the Windows OCR engine (Windows.Media.Ocr). On macOS they are plain net10.0 and use Apple's Vision
    framework instead. The code behind it is guarded by "#if WINDOWS". The cloud (Linux container) and the shared contract
    stay net10.0 everywhere.
  -->
  <PropertyGroup>
    <DesktopTargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows10.0.19041.0</DesktopTargetFramework>
    <DesktopTargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</DesktopTargetFramework>
  </PropertyGroup>

  <!--
    Versioning (single source of truth: Major/Minor below). CI sets Channel / BuildNumber / BuildDate:
      release : <major>.<minor>.<build>-<date>   e.g. 0.1.42-20261114   (branch main)
      nightly : nightly-<build>-<date>          e.g. nightly-43-20261114 (branch dev)
      local   : local-<date>                    e.g. local-20261114      (every local build)
    The build number is the GitHub run number and increases with every build; the update check compares it.
  -->
  <PropertyGroup>
    <ThixClipMajor>0</ThixClipMajor>
    <ThixClipMinor>1</ThixClipMinor>

    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <Channel Condition="'$(Channel)' == ''">local</Channel>
    <BuildDate Condition="'$(BuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyyMMdd'))</BuildDate>

    <Version>$(ThixClipMajor).$(ThixClipMinor).$(BuildNumber)</Version>
    <AssemblyVersion>$(ThixClipMajor).$(ThixClipMinor).0.0</AssemblyVersion>
    <FileVersion>$(ThixClipMajor).$(ThixClipMinor).$(BuildNumber).0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Channel)' == 'release'">
    <InformationalVersion>$(ThixClipMajor).$(ThixClipMinor).$(BuildNumber)-$(BuildDate)</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Channel)' == 'nightly'">
    <InformationalVersion>nightly-$(BuildNumber)-$(BuildDate)</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Channel)' == 'local'">
    <InformationalVersion>local-$(BuildDate)</InformationalVersion>
  </PropertyGroup>

  <!-- The running program needs channel and build number (update check, about page). -->
  <ItemGroup>
    <AssemblyMetadata Include="ThixClipChannel" Value="$(Channel)" />
    <AssemblyMetadata Include="ThixClipBuildNumber" Value="$(BuildNumber)" />
    <AssemblyMetadata Include="ThixClipRepository" Value="Real-TTX/ThixClip" />
  </ItemGroup>

</Project>
